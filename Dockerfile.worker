# Runs the collector/indicator/signal/health pipeline. The only process that talks to Binance and writes to Postgres; api/web/telegram only read what it produced.
#
# Two stages on purpose, both aimed at Railway's per-minute memory billing.
#
# 1. The runtime runs a single pre-bundled .cjs on plain node instead of
#    transpiling TypeScript at boot with tsx. Measured on this app: ~88MB
#    RSS under tsx vs ~71MB running the bundle. Across the three Node
#    services that is real money on a $5 budget, and it was buying nothing.
#
# 2. The runtime carries no monorepo and no build tooling. esbuild inlines
#    every workspace package and npm dependency into the bundle, so the only
#    thing left to install is `pg` — needed because db/migrate.mjs stays an
#    ordinary ESM script (it resolves its own directory through
#    import.meta.url, which a CJS bundle cannot represent).
#
#    Note that `npm prune --omit=dev` is deliberately NOT used here: at a
#    workspace root it does not remove the workspaces' own devDependencies,
#    so tsx, typescript and vitest would ride along into production anyway.
FROM node:22-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages ./packages
COPY apps ./apps
COPY tsconfig.base.json ./

RUN npm install
RUN npx esbuild apps/worker/src/main.ts --bundle --platform=node --format=cjs --target=node22 --keep-names --external:pg-native --external:bufferutil --external:utf-8-validate --outfile=/out/app.cjs
RUN npx esbuild apps/worker/src/backfillMain.ts --bundle --platform=node --format=cjs --target=node22 --keep-names --external:pg-native --external:bufferutil --external:utf-8-validate --outfile=/out/backfill.cjs
# Pinned to whatever version the build above actually resolved, so the
# migration runner can never drift onto a different driver than the one the
# bundle was built and tested against.
RUN mkdir -p /runtime-deps && cd /runtime-deps \
 && echo '{"name":"runtime-deps","private":true}' > package.json \
 && npm install --omit=dev --no-audit --no-fund \
      pg@$(node -p "require('/app/node_modules/pg/package.json').version")

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /runtime-deps/node_modules ./node_modules
COPY --from=build /out/ ./
COPY db ./db

# Migrations are idempotent (schema_migrations tracks what is applied), so
# running them here as well as on api is harmless and means neither service
# can come up ahead of the schema it queries.
#
# The one-shot historical replay ships alongside as backfill.cjs — run it
# from this container with:  node backfill.cjs
CMD ["sh", "-c", "node db/migrate.mjs && node app.cjs"]
