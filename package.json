{
  "name": "crypto-market-health-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "db:migrate": "node db/migrate.mjs",
    "dev:worker": "npm run dev -w @crypto-signal/worker",
    "dev:api": "npm run dev -w @crypto-signal/api",
    "dev:web": "npm run dev -w @crypto-signal/web",
    "dev:telegram": "npm run dev -w @crypto-signal/telegram"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
