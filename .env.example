# --- Database ---
DATABASE_URL=postgres://crypto:crypto@localhost:5432/crypto_market_health


# --- API ---
API_PORT=4000
API_HOST=0.0.0.0

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to receive proactive alerts. Empty = alerts
# only sent to chats that have run /start.
TELEGRAM_ALERT_CHAT_IDS=

# --- Symbols / timeframes (comma-separated). Defaults match the spec. ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Symbols with Binance Futures but no Binance Spot listing (e.g. HYPEUSDT).
# Tracked in reduced mode: OI/funding/liquidation/Futures CVD/volatility and
# the signals that don't need Spot (LONG/SHORT_LIQUIDATION, LONG/SHORT_CROWDING,
# SHORT_COVERING_POSSIBLE). No Health Score, no Spot CVD, no basis — see
# ASSUMPTIONS.md §15. Leave empty if not needed.
FUTURES_ONLY_SYMBOLS=
TIMEFRAMES=5m,15m,1h,4h

# --- Binance ---
BINANCE_SPOT_REST_BASE=https://api.binance.com
BINANCE_SPOT_WS_BASE=wss://stream.binance.com:9443
BINANCE_FUTURES_REST_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com

# --- Signal thresholds (all configurable, see packages/shared/src/config.ts) ---
THRESH_PRICE_CHANGE_PCT=0.3
THRESH_CVD_SKEW_RATIO=0.15
THRESH_OI_CHANGE_PCT=2
THRESH_OI_STRONG_CHANGE_PCT=5
THRESH_FUNDING_ELEVATED_PCT=0.01
THRESH_FUNDING_EXTREME_PCT=0.03
THRESH_VOLUME_ELEVATED_MULT=1.5
THRESH_VOLUME_ABNORMAL_MULT=2
THRESH_VOLUME_EXTREME_MULT=3
THRESH_LIQUIDATION_SPIKE_MULT=3
THRESH_BASIS_ELEVATED_PCT=0.1

# --- Alerting ---
ALERT_COOLDOWN_MINUTES=30
ALERT_CONFIDENCE_DELTA_RETRIGGER=15

# --- Logging ---
LOG_LEVEL=info

# --- Small-cap discovery ("hidden gem") scanner — opt-in, worker only ---
# A separate subsystem from the Binance market-health pipeline: different
# data sources (DEX aggregators), different metrics, different risks.
# See ASSUMPTIONS.md §16 before trusting any number it produces.
GEM_SCAN_ENABLED=false
GEM_CHAINS=solana
GEM_SCAN_INTERVAL_MINUTES=30

# Eligibility window — anything outside it isn't the profile this scans for.
GEM_MIN_LIQUIDITY_USD=50000
GEM_MAX_LIQUIDITY_USD=5000000
GEM_MIN_VOLUME_24H_USD=25000
GEM_MIN_AGE_DAYS=7
GEM_MAX_FDV_USD=50000000
# Hard cutoff: already up this much in 24h is a crowded trade, not a discovery — excluded outright, not just down-scored.
GEM_EXTREME_PUMP_24H_PCT=300

# Scoring shape.
GEM_IDEAL_VOLUME_TO_LIQUIDITY=1.5
GEM_MAX_HEALTHY_VOLUME_TO_LIQUIDITY=10
GEM_IDEAL_AGE_DAYS=60
GEM_VERTICAL_PUMP_24H_PCT=100

# Alerting.
GEM_ALERT_MIN_SCORE=70
GEM_ALERT_COOLDOWN_HOURS=24

# Position watches ("/watch SYMBOL" on the bot) — independent of discovery above.
GEM_WATCH_CHECK_INTERVAL_MINUTES=15
GEM_WATCH_STOP_LOSS_PCT=25
GEM_WATCH_TAKE_PROFIT_PCT=50
GEM_WATCH_LIQUIDITY_COLLAPSE_PCT=50
GEM_WATCH_RISK_SCORE_ALERT=80

# Optional. RugCheck (Solana safety screening) documents a per-developer key.
# Without it screening is attempted unauthenticated and degrades to
# "unverified" — never to "safe".
RUGCHECK_API_KEY=

# --- AI layer (optional, Phase 32 in spec — not implemented in MVP) ---
ANTHROPIC_API_KEY=

# --- One-shot historical replay (worker only) ---
# Set to a number of days and redeploy to replay that window once; the
# worker skips it if a replay already succeeded in the last 20 hours, so a
# restart cannot re-trigger it. Capped at 30 — Binance serves no older
# open-interest history. See DEPLOY.md.
# BACKFILL_DAYS=30
