# worker + api (+ telegram) in ONE container, for free hosts that only give a
# single always-on service without a credit card (e.g. Render free web
# service). Same bundles as Dockerfile.worker/.api/.telegram — only the
# packaging differs. Railway users keep the per-service Dockerfiles.
#
# See DEPLOY.md → "Backend — Render + Supabase".
FROM node:22-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages ./packages
COPY apps ./apps
COPY tsconfig.base.json ./

RUN npm install
RUN npx esbuild apps/worker/src/main.ts --bundle --platform=node --format=cjs --target=node22 --keep-names --external:pg-native --external:bufferutil --external:utf-8-validate --outfile=/out/worker.cjs
RUN npx esbuild apps/worker/src/backfillMain.ts --bundle --platform=node --format=cjs --target=node22 --keep-names --external:pg-native --external:bufferutil --external:utf-8-validate --outfile=/out/backfill.cjs
RUN npx esbuild apps/api/src/server.ts --bundle --platform=node --format=cjs --target=node22 --keep-names --external:pg-native --external:bufferutil --external:utf-8-validate --outfile=/out/api.cjs
# --keep-names is load-bearing for the bot — see Dockerfile.telegram.
RUN npx esbuild apps/telegram/src/main.ts --bundle --platform=node --format=cjs --target=node22 --keep-names --external:pg-native --external:bufferutil --external:utf-8-validate --outfile=/out/telegram.cjs

RUN mkdir -p /runtime-deps && cd /runtime-deps \
 && echo '{"name":"runtime-deps","private":true}' > package.json \
 && npm install --omit=dev --no-audit --no-fund \
      pg@$(node -p "require('/app/node_modules/pg/package.json').version")

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
# Two pools (api + worker) share one free-tier Postgres connection budget.
ENV PG_POOL_MAX=5
EXPOSE 4000

COPY --from=build /runtime-deps/node_modules ./node_modules
COPY --from=build /out/ ./
COPY db ./db
COPY scripts/start-all.sh ./start-all.sh

CMD ["bash", "start-all.sh"]
